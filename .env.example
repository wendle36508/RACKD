# RACKD secrets and settings.
# 1. Copy this file and name the copy exactly:  .env
# 2. Fill in the values in the copy.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

# Apify: Settings > API & Integrations > Personal API token (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

# Which Apify actor scrapes Depop (owner~name, as shown in the actor's URL)
DEPOP_ACTOR_ID=abotapi~depop-scraper

# Which listing sources are switched on, comma separated (only depop exists so far)
SOURCES=depop

# Country for the Apify Residential proxy
APIFY_PROXY_COUNTRY=US

# Later, floor 3 (cloud database). Leave blank until then.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Later, floor 7 (money). Leave blank until then.
EBAY_CAMPAIGN_ID=
