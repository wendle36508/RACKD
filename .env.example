# RACKD secrets and settings.
# 1. Copy this file and name the copy exactly:  .env
# 2. Fill in the values in the copy.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

# Apify: Settings > API & Integrations > Personal API token (https://console.apify.com/settings/integrations)
APIFY_TOKEN=

# Which Apify actor scrapes Depop (owner~name, as shown in the actor's URL)
DEPOP_ACTOR_ID=piotrv1001~depop-listings-scraper

# Vinted and eBay scrapers on Apify (blank until chosen)
VINTED_ACTOR_ID=
EBAY_ACTOR_ID=

# Which listing sources are switched on, comma separated: vinted, depop, ebay
# Each refresh is split 50% Vinted, 30% Depop, 20% eBay (1-sources/sources.config.js)
SOURCES=depop

# Spend guard: scraping stops for the month once this many dollars are spent on Apify.
# On Apify's Free plan ($5 of credit a month) set this to 5, so RACKD stops before Apify does.
MONTHLY_BUDGET_USD=330

# Extra Residential proxy cost per 1,000 listings, if Apify bills it on top (0 if not)
PROXY_USD_PER_1000=0

# Port for the app server (open http://localhost:3000)
PORT=3000

# Country for the Apify Residential proxy
APIFY_PROXY_COUNTRY=US

# Alert emails (free at resend.com): budget at 50% / 80% / 100%, failed scrapes, stuck
# refreshes, and the daily summary. Without these, alerts still go to logs/ALERTS.txt.
RESEND_API_KEY=
ALERT_EMAIL_TO=

# Later, floor 3 (cloud database). Leave blank until then.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Later, floor 7 (money). Leave blank until then.
EBAY_CAMPAIGN_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Your Stripe payment link for the $9.99/month membership (the app's "Become a member" button)
STRIPE_CHECKOUT_URL=

# TEST MODE (off): only for you, trying RACKD on your own laptop before Stripe exists. Put
# true here and everyone on that laptop counts as a member. Never on for real users: there is
# no free trial or demo, people subscribe first. The health check shows amber while it's on.
TEST_MODE_EVERYONE_IS_MEMBER=
